# Public site URL (no trailing slash). Used for canonical, OG, sitemap.
# Set to your custom domain in production, e.g. https://softdesk.app
PUBLIC_SITE_URL=https://soft-desk-landing.pages.dev

# Google Analytics 4 Measurement ID (G-XXXXXXXXXX)
# PUBLIC_ prefix exposes to client-side (Astro convention)
PUBLIC_GA_MEASUREMENT_ID=

# Microsoft Clarity Project ID
PUBLIC_CLARITY_PROJECT_ID=
