---
import BayjfLink from '@bay/landing-ui/components/BayjfLink.astro';
import StarOnGithub from '@bay/landing-ui/components/StarOnGithub.astro';
import { useTranslations, localizedPath } from '@/i18n/utils';
import type { Language } from '@/i18n/ui';
import LanguageSwitcher from './LanguageSwitcher.astro';
import Logo from './Logo.astro';

interface Props {
  lang: Language;
  path: string;
}

const { lang, path } = Astro.props;
const t = useTranslations(lang);

const navLinks = [
  { key: 'nav.features' as const, href: `${localizedPath('/', lang)}#features` },
  { key: 'nav.download' as const, href: localizedPath('/download', lang) },
  { key: 'nav.demo' as const, href: localizedPath('/app/dashboard', lang) },
  { key: 'nav.privacy' as const, href: localizedPath('/privacy', lang) },
];
---

<header class="sticky top-0 z-40 border-b border-gray-800/80 bg-[#0d1117]/90 backdrop-blur-md">
  <nav class="mx-auto flex h-16 max-w-6xl items-center justify-between px-4 sm:px-6">
    <!-- Logo -->
    <a href={localizedPath('/', lang)} class="flex items-center gap-2.5">
      <Logo class="h-8 w-8" />
      <span class="text-lg font-bold tracking-tight text-white">SoftDesk</span>
    </a>

    <!-- Desktop Nav -->
    <div class="hidden items-center gap-6 md:flex">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class="text-sm text-gray-400 transition-colors hover:text-white"
        >
          {t(link.key)}
        </a>
      ))}
    </div>

    <!-- Right side -->
    <div class="flex items-center gap-4">
      <LanguageSwitcher lang={lang} path={path} />
      <BayjfLink
        size={18}
        class="hidden text-sm text-gray-400 transition-colors hover:text-white sm:block"
      />
      <StarOnGithub
        href="https://github.com/bayernjf/soft-desk"
        size={15}
        class="hidden text-gray-400 sm:inline-flex"
      />
      <a
        href={localizedPath('/download', lang)}
        class="hidden rounded-lg bg-brand px-4 py-2 text-sm font-medium text-white transition-colors hover:bg-brand-dark sm:block"
      >
        {t('hero.cta_primary')}
      </a>
    </div>
  </nav>

  <!-- Mobile Nav -->
  <div class="flex items-center justify-around border-t border-gray-800 px-4 py-2 md:hidden">
    {navLinks.map((link) => (
      <a
        href={link.href}
        class="text-xs text-gray-400 transition-colors hover:text-white"
      >
        {t(link.key)}
      </a>
    ))}
  </div>
</header>
