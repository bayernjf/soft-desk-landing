---
import { useTranslations, localizedPath } from '@/i18n/utils';
import type { Language } from '@/i18n/ui';
import LanguageSwitcher from './LanguageSwitcher.astro';

interface Props {
  lang: Language;
  path: string;
}

const { lang, path } = Astro.props;
const t = useTranslations(lang);

const navLinks = [
  { key: 'nav.features' as const, href: `${localizedPath('/', lang)}#features` },
  { key: 'nav.download' as const, href: localizedPath('/download', lang) },
  { key: 'nav.demo' as const, href: '/app/dashboard' },
  { key: 'nav.privacy' as const, href: localizedPath('/privacy', lang) },
];
---

<header class="sticky top-0 z-40 border-b border-gray-800/80 bg-[#0d1117]/90 backdrop-blur-md">
  <nav class="mx-auto flex h-16 max-w-6xl items-center justify-between px-4 sm:px-6">
    <!-- Logo -->
    <a href={localizedPath('/', lang)} class="flex items-center gap-2.5">
      <svg viewBox="0 0 512 512" fill="none" xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 rounded-lg shadow-[0_0_18px_-4px_rgba(124,58,237,0.55)]">
        <rect width="512" height="512" rx="115" fill="url(#softdesk-nav)" />
        <path d="M156 136 H266 a120 120 0 0 1 0 240 H156 Z" fill="none" stroke="#ffffff" stroke-width="40" stroke-linejoin="round" />
        <path d="M214 206 L300 256 L214 306 Z" fill="#ffffff" />
        <rect x="150" y="392" width="212" height="20" rx="10" fill="#ffffff" fill-opacity="0.9" />
        <defs>
          <linearGradient id="softdesk-nav" x1="0" y1="0" x2="512" y2="512" gradientUnits="userSpaceOnUse">
            <stop offset="0%" stop-color="#7c3aed" />
            <stop offset="50%" stop-color="#ec4899" />
            <stop offset="100%" stop-color="#f59e0b" />
          </linearGradient>
        </defs>
      </svg>
      <span class="text-lg font-bold tracking-tight text-white">SoftDesk</span>
    </a>

    <!-- Desktop Nav -->
    <div class="hidden items-center gap-6 md:flex">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class="text-sm text-gray-400 transition-colors hover:text-white"
        >
          {t(link.key)}
        </a>
      ))}
    </div>

    <!-- Right side -->
    <div class="flex items-center gap-4">
      <LanguageSwitcher lang={lang} path={path} />
      <a
        href="https://github.com/bayernjf/soft-desk"
        target="_blank"
        rel="noopener noreferrer"
        class="text-gray-400 transition-colors hover:text-white"
        aria-label="GitHub"
      >
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/></svg>
      </a>
      <a
        href={localizedPath('/download', lang)}
        class="hidden rounded-lg bg-brand px-4 py-2 text-sm font-medium text-white transition-colors hover:bg-brand-dark sm:block"
      >
        {t('hero.cta_primary')}
      </a>
    </div>
  </nav>

  <!-- Mobile Nav -->
  <div class="flex items-center justify-around border-t border-gray-800 px-4 py-2 md:hidden">
    {navLinks.map((link) => (
      <a
        href={link.href}
        class="text-xs text-gray-400 transition-colors hover:text-white"
      >
        {t(link.key)}
      </a>
    ))}
  </div>
</header>
