---
import { useTranslations } from '@/i18n/utils';
import type { Language } from '@/i18n/ui';
import { FALLBACK_URL } from '@/lib/download-urls';

interface Props {
  lang: Language;
  variant?: 'hero' | 'section';
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<div class="flex flex-col gap-3 sm:flex-row sm:gap-4" id="download-buttons">
  <a
    data-download-mac
    href={FALLBACK_URL}
    class="inline-flex items-center justify-center gap-2 rounded-lg bg-brand px-6 py-3 text-sm font-medium text-white transition-colors hover:bg-brand-dark"
  >
    <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor"><path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.81-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z"/></svg>
    <span>{t('cta.download_mac')}</span>
  </a>
  <a
    data-download-win
    href={FALLBACK_URL}
    class="inline-flex items-center justify-center gap-2 rounded-lg border border-gray-700 bg-[#161b22] px-6 py-3 text-sm font-medium text-gray-200 transition-colors hover:border-gray-600 hover:bg-[#1c2330]"
  >
    <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor"><path d="M0 3.449L9.75 2.1v9.451H0m10.949-9.602L24 0v11.4H10.949M0 12.6h9.75v9.451L0 20.699M10.949 12.6H24V24l-12.9-1.801"/></svg>
    <span>{t('cta.download_win')}</span>
  </a>
</div>

<!-- Toast for download fetch errors -->
<div id="download-toast" class="fixed bottom-6 left-1/2 z-50 hidden -translate-x-1/2 rounded-lg border border-amber-500/30 bg-amber-500/10 px-4 py-2.5 text-sm text-amber-300 backdrop-blur-sm">
  {lang === 'zh' ? '无法获取最新版本信息，已链接到 GitHub Releases 页面' : 'Could not fetch latest release info, redirecting to GitHub Releases'}
</div>

<script>
  import { fetchDownloadUrls, formatBytes, detectPlatform } from '@/lib/download-urls';

  function showToast() {
    const toast = document.getElementById('download-toast');
    if (!toast) return;
    toast.classList.remove('hidden');
    setTimeout(() => toast.classList.add('hidden'), 5000);
  }

  const PRIMARY = ['bg-brand', 'text-white', 'hover:bg-brand-dark', 'ring-2', 'ring-brand', 'ring-offset-2', 'ring-offset-[#0d1117]'];
  const SECONDARY = ['border', 'border-gray-700', 'bg-[#161b22]', 'text-gray-200', 'hover:border-gray-600', 'hover:bg-[#1c2330]'];

  function setEmphasis(el: Element, primary: boolean) {
    el.classList.remove(...(primary ? SECONDARY : PRIMARY));
    el.classList.add(...(primary ? PRIMARY : SECONDARY));
  }

  async function updateDownloadButtons() {
    const state = await fetchDownloadUrls();
    if (state.loading) return;
    if (state.error) showToast();

    const macBtns = document.querySelectorAll('[data-download-mac]');
    const winBtns = document.querySelectorAll('[data-download-win]');

    if (state.mac) {
      const { url, size } = state.mac;
      macBtns.forEach((btn) => {
        btn.setAttribute('href', url);
        btn.setAttribute('title', formatBytes(size));
      });
    }
    if (state.win) {
      const { url, size } = state.win;
      winBtns.forEach((btn) => {
        btn.setAttribute('href', url);
        btn.setAttribute('title', formatBytes(size));
      });
    }

    // Emphasize the visitor's platform, de-emphasize the other one
    const preferred = detectPlatform();
    if (preferred !== 'mac' && preferred !== 'win') return;
    macBtns.forEach((btn) => setEmphasis(btn, preferred === 'mac'));
    winBtns.forEach((btn) => setEmphasis(btn, preferred === 'win'));
  }

  updateDownloadButtons();
</script>
