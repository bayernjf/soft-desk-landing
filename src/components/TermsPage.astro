---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { useTranslations, localizedPath } from '@/i18n/utils';
import type { Language } from '@/i18n/ui';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const isZh = lang === 'zh';

const sections = isZh ? [
  { title: '1. 接受条款', body: '欢迎使用 SoftDesk 及其官方网站。访问本网站或使用本应用即表示你已阅读、理解并同意接受本服务条款的约束。如不同意,请停止使用。' },
  { title: '2. 软件许可', body: 'SoftDesk 桌面应用按随附的开源许可证发布。你可以在许可范围内免费使用、复制和分发本软件。许可条款以应用仓库中的 LICENSE 文件为准。' },
  { title: '3. 账户与云同步', body: '云同步为可选功能。若你启用该功能,你需自行保管账户凭据,并对通过该账户进行的操作负责。我们可随时暂停或终止云同步服务。' },
  { title: '4. 可接受的使用', body: '你不得将本软件或本网站用于任何违法用途,不得尝试破坏、逆向工程本网站或相关服务,不得干扰其他用户的正常使用。' },
  { title: '5. 知识产权', body: '本网站的内容(文案、图片、代码等)归 SoftDesk 及其贡献者所有。未经授权的复制或商业用途需遵循相应的开源许可。' },
  { title: '6. 免责声明与责任限制', body: '本软件与网站按"现状"提供,不附带任何明示或暗示的保证。在法律允许的最大范围内,我们对因使用本软件或网站而产生的任何间接、附带或后果性损害不承担责任。' },
  { title: '7. 条款变更与联系', body: '我们可能不时更新本条款,更新后将在本页公布。继续使用即视为接受变更后的条款。如有问题,请通过 GitHub Issues 联系我们。' },
] : [
  { title: '1. Acceptance of Terms', body: 'Welcome to SoftDesk and its official website. By accessing this website or using this application, you agree to be bound by these Terms of Service. If you do not agree, please stop using them.' },
  { title: '2. Software License', body: 'The SoftDesk desktop application is released under its accompanying open-source license. You may use, copy, and distribute the software free of charge within the scope of that license. The LICENSE file in the application repository governs the license terms.' },
  { title: '3. Accounts & Cloud Sync', body: 'Cloud sync is an optional feature. If you enable it, you are responsible for safeguarding your account credentials and for all activity conducted through that account. We may suspend or terminate the cloud sync service at any time.' },
  { title: '4. Acceptable Use', body: 'You must not use the software or website for any unlawful purpose, attempt to disrupt or reverse-engineer the website or related services, or interfere with other users\' normal use.' },
  { title: '5. Intellectual Property', body: 'The content of this website (text, images, code, etc.) is owned by SoftDesk and its contributors. Reproduction or commercial use without authorization must comply with the applicable open-source licenses.' },
  { title: '6. Disclaimer & Limitation of Liability', body: 'The software and website are provided "as is" without any express or implied warranties. To the maximum extent permitted by law, we are not liable for any indirect, incidental, or consequential damages arising from use of the software or website.' },
  { title: '7. Changes & Contact', body: 'We may update these terms from time to time; changes will be posted on this page. Continued use constitutes acceptance of the revised terms. For questions, please contact us via GitHub Issues.' },
];
---

<BaseLayout
  title={`${t('footer.terms')} — SoftDesk`}
  description={isZh ? 'SoftDesk 服务条款 - 了解使用本软件与网站的条件与限制' : 'SoftDesk Terms of Service - Conditions and limitations for using the software and website'}
  path="/terms"
  lang={lang}
>
  <article class="mx-auto max-w-3xl px-4 py-16 sm:px-6">
    <h1 class="mb-8 text-3xl font-bold text-white">{t('footer.terms')}</h1>
    <div class="space-y-8">
      {sections.map((section) => (
        <section>
          <h2 class="mb-3 text-xl font-semibold text-white">{section.title}</h2>
          <p class="text-gray-400 leading-relaxed">{section.body}</p>
        </section>
      ))}
    </div>
    <div class="mt-12 border-t border-gray-800 pt-6">
      <a href={localizedPath('/', lang)} class="text-sm text-brand hover:text-brand-dark">
        ← {t('error.404.back')}
      </a>
    </div>
  </article>
</BaseLayout>
