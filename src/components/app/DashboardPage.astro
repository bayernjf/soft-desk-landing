---
import AppLayout from '@/layouts/AppLayout.astro';
import DashboardApp from './DashboardApp.tsx';
import { getCategories, getMockSoftware, getMockWorkflows } from '@/data/software';
import { appStrings } from '@/i18n/app';
import type { Language } from '@/i18n/ui';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const t = appStrings[lang];
---

<AppLayout lang={lang} title={t.shell.pageTitles.dashboard} activePage="dashboard">
  <DashboardApp
    client:load
    software={getMockSoftware(lang)}
    workflows={getMockWorkflows(lang)}
    categories={getCategories(lang)}
    strings={t.dashboard}
  />
</AppLayout>
