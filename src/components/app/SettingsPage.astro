---
import AppLayout from '@/layouts/AppLayout.astro';
import SettingsApp from './SettingsApp.tsx';
import { appStrings } from '@/i18n/app';
import type { Language } from '@/i18n/ui';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const t = appStrings[lang];
---

<AppLayout lang={lang} title={t.shell.pageTitles.settings} activePage="settings">
  <SettingsApp
    client:load
    strings={t.settings}
  />
</AppLayout>
