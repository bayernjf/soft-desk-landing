---
import AppLayout from '@/layouts/AppLayout.astro';
import StatisticsApp from './StatisticsApp.tsx';
import { getCategories, getMockSoftware, getMockStats } from '@/data/software';
import { appStrings } from '@/i18n/app';
import type { Language } from '@/i18n/ui';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const t = appStrings[lang];
---

<AppLayout lang={lang} title={t.shell.pageTitles.statistics} activePage="statistics">
  <StatisticsApp
    client:load
    software={getMockSoftware(lang)}
    stats={getMockStats(lang)}
    categories={getCategories(lang)}
    strings={t.statistics}
  />
</AppLayout>
