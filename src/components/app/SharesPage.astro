---
import AppLayout from '@/layouts/AppLayout.astro';
import MySharesApp from './MySharesApp.tsx';
import { appStrings } from '@/i18n/app';
import type { Language } from '@/i18n/ui';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const t = appStrings[lang];
---

<AppLayout lang={lang} title={t.shell.pageTitles.shares} activePage="shares">
  <MySharesApp
    client:load
    strings={t.shares}
  />
</AppLayout>
