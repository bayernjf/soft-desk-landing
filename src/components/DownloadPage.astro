---
import BaseLayout from '@/layouts/BaseLayout.astro';
import DownloadButtons from '@/components/DownloadButtons.astro';
import { useTranslations } from '@/i18n/utils';
import type { Language } from '@/i18n/ui';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<BaseLayout
  title={`${t('download.title')} — SoftDesk`}
  description={t('download.subtitle')}
  path="/download"
  lang={lang}
>
  <section class="mx-auto max-w-3xl px-4 py-16 text-center sm:px-6 sm:py-24" data-analytics-section="download">
    <h1 class="text-3xl font-bold text-white sm:text-5xl">{t('download.title')}</h1>
    <p class="mt-4 text-gray-400">{t('download.subtitle')}</p>

    <div class="mt-12 flex flex-col items-center gap-6">
      <DownloadButtons lang={lang} variant="section" />

      <div id="release-info" class="text-sm text-gray-500">
        {t('download.loading')}
      </div>
    </div>

    <div class="mt-8">
      <a
        href="https://github.com/bayernjf/soft-desk/releases"
        target="_blank"
        rel="noopener noreferrer"
        class="text-sm text-gray-400 transition-colors hover:text-white"
      >
        {t('download.fallback')} →
      </a>
    </div>
  </section>
</BaseLayout>

<script>
  import { fetchDownloadUrls } from '@/lib/download-urls';

  async function updateReleaseInfo() {
    const state = await fetchDownloadUrls();
    const info = document.getElementById('release-info');
    if (!info) return;

    if (state.version) {
      const date = state.publishedAt ? new Date(state.publishedAt).toLocaleDateString() : '';
      info.textContent = `${info.dataset.versionLabel || 'Version'} ${state.version} · ${date}`;
    } else {
      info.textContent = '';
    }
  }

  updateReleaseInfo();
</script>
