---
import '@/styles/global.css';
import BaseHead from '@/components/BaseHead.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import Analytics from '@/components/Analytics.astro';
import CookieBanner from '@/components/CookieBanner.astro';
import { baseSchema } from '@/lib/seo';
import type { Language } from '@/i18n/ui';

interface Props {
  title: string;
  description: string;
  path: string;
  lang: Language;
  image?: string;
  noindex?: boolean;
}

const { title, description, path, lang, image, noindex } = Astro.props;
const orgSchema = baseSchema(lang);
---

<!doctype html>
<html lang={lang === 'zh' ? 'zh-CN' : 'en'} class="dark">
  <head>
    <BaseHead
      title={title}
      description={description}
      path={path}
      lang={lang}
      image={image}
      noindex={noindex}
    />
    <slot name="head" />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(orgSchema)} />
  </head>
  <body class="min-h-screen bg-[#0d1117] text-gray-100 antialiased">
    <Header lang={lang} path={path} />
    <main>
      <slot />
    </main>
    <Footer lang={lang} />
    <CookieBanner lang={lang} />
    <Analytics lang={lang} />
  </body>
</html>
